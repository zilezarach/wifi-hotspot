# Database
DATABASE_URL=postgresql://testuser:testpass@localhost:5432/testdb

# Server Configuration
NODE_ENV=development
SERVER_PORT=5000
SERVER_IP=0.0.0.0
DOMAIN=http://localhost:5000

# MikroTik Router (optional for multi-tenant, required for single tenant)
MIKROTIK_HOST=192.168.88.1
MIKROTIK_USER=admin
MIKROTIK_PASS=your_mikrotik_password
MIKROTIK_PORT=8728

# M-Pesa Daraja API
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=your_shortcode
MPESA_PASSKEY=your_passkey
MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa/callback

# Security
ENCRYPTION_KEY=generate_a_secure_32_character_key
# Run `pnpm generate-key` to generate a secure value for this variable.
